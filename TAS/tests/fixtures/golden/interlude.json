    "cast": [
      {
        "id": "myra",
        "name": "マイラ・ヴェイン",
        "nameEn": "Myra Vane",
        "public": "ランタンヒル村の顔役。廃坑再開で村を立て直したい。実利的だが村人思いに見える元行商人",
        "direction": "報告に『青く脈打つ石』への言及があれば、抑えきれない関心を一瞬見せろ。すぐ取り繕わせろ"
      },
      {
        "id": "npc_1",
        "name": "マイラ",
        "public": "村の長である。全体のことを優先的に考える。なぜか青い石の行方を追っている。"
      },
      {
        "id": "npc_2",
        "name": "灯りの番人",
        "public": "話をすることはできない。"
      },
      {
        "id": "npc_3",
        "name": "村人",
        "public": "素朴な口調。マイラの部屋を示す。マイラが村人より興味を持っているものがあると秘密めいたことを言う。"
      }
    ],
    "companions": [
      {
        "id": "member_1",
        "name": "リディア",
        "persona": "遺工に詳しい斥候である。物事を慎重に考える。皮肉をよく言う。ガレスの尻ぬぐいをいつもしている。",
        "flags": {
          "chat": true,
          "propose": true,
          "act": false,
          "mutate": false
        },
        "image": "assets/casts/member_1.png",
        "sprite": "portrait_lydia_alt.png",
        "gender": "female",
        "firstPerson": "わたし",
        "addressTerm": "あなた",
        "quirks": [
          {
            "mutter": "遺工は、急いで触るものじゃないわ。"
          },
          {
            "mutter": "ガレス、壊すのは調べてからにして。"
          },
          {
            "mutter": "足元を見て。古い仕掛けかもしれない。"
          }
        ],
        "battleMutters": [
          "無茶をしないで、ガレス。",
          "急がないで。相手の癖を見てからでも遅くないわ。",
          "間合いが遠いわ。もう半歩、退がって。",
          "息を整えて、あなた。一度で決めなくていい。"
        ],
        "battleEnd": {
          "win": [
            "片付いたわね。次は痕跡を見ましょう。"
          ],
          "fled": [
            "引く判断は正しいわ。道を変えましょう。"
          ],
          "repelled": [
            "追い払えたみたい。今のうちに進みましょう。"
          ]
        },
        "idleLine": "何か見つけた？",
        "speechFrequency": "standard"
      },
      {
        "id": "member_2",
        "name": "ガレス",
        "persona": "無口な戦士である。言葉を少なく話す。実用的な動きだけをする。",
        "flags": {
          "chat": true,
          "propose": true,
          "act": false,
          "mutate": false
        },
        "image": "assets/casts/member_2.png",
        "sprite": "portrait_gareth_alt.png",
        "gender": "male",
        "firstPerson": "俺",
        "addressTerm": "お前",
        "quirks": [
          {
            "mutter": "道を見ろ。"
          },
          {
            "mutter": "必要な物だけ持つ。"
          }
        ],
        "battleMutters": [
          "下がれ。",
          "俺が前に出る。",
          "お前は右へ回れ。",
          "まだ持つ。続けろ。"
        ],
        "battleEnd": {
          "win": [
            "終わりだ。進める。"
          ],
          "fled": [
            "退く。足を止めるな。"
          ],
          "repelled": [
            "追い払った。今だ。"
          ]
        },
        "idleLine": "なんだ。",
        "speechFrequency": "standard"
      }
    ],
