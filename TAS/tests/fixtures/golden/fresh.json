  "chapter": {
    "id": 1,
    "title": "チャプター1",
    "quest": "灯りの正体を確かめ、坑道が使えるか村に報告する(依頼人:村の顔役マイラ・ヴェイン)",
    "flagsOut": [
      "kept_heartstone_shard"
    ],
    "healing": [
      {
        "name": "回復薬",
        "amount": 4,
        "text": "封を切って一息にあおった。傷の熱が引いていく。"
      }
    ],
    "intro": {
      "id": "ch1_intro",
      "name": "マイラの部屋",
      "brief": "夕暮れの村。マイラ・ヴェインは机に「坑道」の古い「見取り図」を広げ、坑道の奥から聞こえる「金属音」について静かに語り始める。",
      "img": "s4_myra_room.jpg",
      "npcSprite": "s4_myra_full_transparent.png",
      "npc": {
        "id": "npc_1",
        "name": "マイラ"
      },
      "exits": [
        {
          "id": "to_scean01",
          "match": [
            "引き受け",
            "承知",
            "わかった",
            "分かった",
            "任せ",
            "受ける",
            "どうする"
          ],
          "to": "scene:1",
          "addItems": [
            "干し肉と水袋"
          ],
          "npcSay": "坑道の奥から、まだ物音がするの。危ないのは分かってる。……これを持って行って。無理はしないで。"
        }
      ],
      "greeting": "わたしの依頼は、火山の古い坑道の奥から、何か物音がしているらしいの。その正体が何か確かめてきて欲しいのだけど、受けてもらえないかしら？",
      "hintChips": [
        "見取り図",
        "金属音",
        "引き受ける"
      ],
      "secrets": [
        {
          "id": "intro_face",
          "entity": "マイラの表情",
          "aliases": [
            "表情",
            "顔",
            "マイラ",
            "様子"
          ],
          "dc": 2,
          "surface": "話しながら、マイラは何度も窓の外へ目をやる。",
          "text": "マイラは目を伏せたまま指を組んでいる。もう少し、この依頼について聞き出せそうだ。",
          "trigger": "",
          "category": "object",
          "importance": "support",
          "usage": "inspect"
        },
        {
          "id": "intro_mine",
          "entity": "坑道",
          "aliases": [
            "坑道",
            "廃坑",
            "鉱山"
          ],
          "dc": 2,
          "surface": "火山のふもとの古い坑道。村はここで生きてきた。",
          "text": "「もう十年以上、誰も使っていない捨てられた坑道だわ。もう誰も近づかない……」",
          "trigger": "",
          "category": "object",
          "importance": "support",
          "usage": "inspect"
        },
        {
          "id": "intro_map",
          "entity": "見取り図",
          "aliases": [
            "見取り図",
            "地図",
            "図面",
            "図"
          ],
          "dc": 2,
          "surface": "机に広げられた、坑道の古い見取り図。",
          "text": "「一応、何かの手がかりにはなるかもね。でも、かなりの場所が崩れているらしいわ」",
          "trigger": "",
          "category": "object",
          "importance": "support",
          "usage": "inspect"
        },
        {
          "id": "intro_sound",
          "entity": "金属音",
          "aliases": [
            "金属音",
            "物音",
            "音",
            "かんかん"
          ],
          "dc": 2,
          "surface": "マイラは声を落として、坑道の奥から聞こえるという音の話をした。",
          "text": "「坑道の奥から微かに響いているわ。これが何を意味しているのか、わたしには分からない」",
          "trigger": "",
          "category": "object",
          "importance": "support",
          "usage": "inspect"
        }
      ],
