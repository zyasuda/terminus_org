  "cast": [
    {
      "id": "myra",
      "name": "マイラ・ヴェイン",
      "nameEn": "Myra Vane",
      "public": "ランタンヒル村の顔役。廃坑再開で村を立て直したい。実利的だが村人思いに見える元行商人",
      "direction": "報告に『青く脈打つ石』への言及があれば、抑えきれない関心を一瞬見せろ。すぐ取り繕わせろ"
    }
  ],
  "companions": [
    {
      "id": "member_1",
      "name": "リディア",
      "persona": "遺工に詳しい斥候である。物事を慎重に考える。皮肉をよく言う。ガレスの尻ぬぐいをいつもしている。",
      "flags": {
        "chat": true,
        "propose": true,
        "act": false,
        "mutate": false
      },
      "image": "assets/casts/member_1.png",
      "sprite": "portrait_lydia_alt.png",
      "gender": "female",
      "firstPerson": "わたし",
      "addressTerm": "あなた",
      "quirks": [
        { "mutter": "遺工は、急いで触るものじゃないわ。" },
        { "mutter": "ガレス、壊すのは調べてからにして。" }
      ],
      "battleMutters": [
        "足元を見て。古い仕掛けかもしれない。",
        "無茶をしないで、ガレス。"
      ],
      "battleEnd": {
        "win": ["片付いたわね。次は痕跡を見ましょう。"],
        "fled": ["引く判断は正しいわ。道を変えましょう。"],
        "repelled": ["追い払えたみたい。今のうちに進みましょう。"]
      },
      "idleLine": "何か見つけた？"
    },
    {
      "id": "member_2",
      "name": "ガレス",
      "persona": "無口な戦士である。言葉を少なく話す。実用的な動きだけをする。",
      "flags": {
        "chat": true,
        "propose": true,
        "act": false,
        "mutate": false
      },
      "image": "assets/casts/member_2.png",
      "sprite": "portrait_gareth_alt.png",
      "gender": "male",
      "firstPerson": "俺",
      "addressTerm": "お前",
      "quirks": [
        { "mutter": "道を見ろ。" },
        { "mutter": "必要な物だけ持つ。" }
      ],
      "battleMutters": [
        "下がれ。",
        "俺が前に出る。"
      ],
      "battleEnd": {
        "win": ["終わりだ。進める。"],
        "fled": ["退く。足を止めるな。"],
        "repelled": ["追い払った。今だ。"]
      },
      "idleLine": "なんだ。"
    }
  ],
  "companionsHint": "場面に合う方を選べ(戦闘寄り=ガレス、調査・遺工・慎重論=リディア)",
